# Copy this file to .env if you want to override the defaults.
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_HOST=http://ollama:11434
EMAIL_MCP_URL=http://email-mcp:8001/mcp
REPORT_MCP_URL=http://report-mcp:8002/mcp
SEARCH_MCP_URL=http://search-mcp:8003/mcp

# Optional real email delivery.
# Leave SMTP_HOST empty to save emails as .eml files in the artifacts volume.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<app password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false
